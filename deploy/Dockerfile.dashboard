FROM node:22-alpine AS build
WORKDIR /app
COPY dashboard/package.json ./
RUN npm install --no-audit --no-fund
COPY dashboard ./
RUN npm run build
FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/.next/standalone ./
COPY --from=build /app/.next/static ./.next/static
EXPOSE 3400
ENV PORT=3400
CMD ["node", "server.js"]
